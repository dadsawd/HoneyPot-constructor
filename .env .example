# ==============================================================================
# HoneyForge Конфигурационный Шаблон (.env.example)
# Команда: Alotropy&&Branch
# Инструкция: Скопируйте этот файл, переименуйте в .env и заполните своими данными.
# ==============================================================================

# --- НАСТРОЙКИ СЕРВЕРА БЭКЕНДА (FastAPI) ---
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# --- ПОДКЛЮЧЕНИЕ К БАЗЕ ДАННЫХ (PostgreSQL) ---
# Шаблон: postgresql://ЛОГИН:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
# Для локального тестирования в Docker используйте строку ниже:
DB_URL=postgresql://admin:secret_pass@127.0.0.1:5432/honeyforge_db

# --- НАСТРОЙКИ МАСКИРОВКИ КАНАЛА (Требования MASK-2 / MASK-4) ---
# Скрытый эндпоинт, на который ловушки будут незаметно слать логи
ANALYTICS_ENDPOINT=/static/chunks/metrics.js
# Фейковое имя процесса внутри контейнеров, чтобы запутать хакера
FAKE_PROCESS_NAME=syslogd-net

# --- ПУТИ К ШАБЛОНАМ ПРИМАНОК (Medium-уровень) ---
# Пути к HTML-интерфейсам, которые будут подгружаться в ловушки
TEMPLATE_WP_LOGIN=pots/templates/wp_login.html
TEMPLATE_SENSITIVE_ENV=pots/templates/env_fake.html
